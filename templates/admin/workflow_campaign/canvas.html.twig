{% extends '@SyliusAdmin/layout.html.twig' %}

{% block title %}Edit Workflow: {{ campaign.name }}{% endblock %}

{% block content %}
<div
    id="sylius-workflow-editor"
    data-workflow-id="{{ campaign.id }}"
    data-graph="{{ campaign.graph|json_encode|e('html_attr') }}"
    data-api-url="/api/v2/admin/workflows/{{ campaign.id }}/graph"
    data-workflow-name="{{ campaign.name|e('html_attr') }}"
    data-workflow-status="{{ campaign.status.value }}"
    style="height: calc(100vh - 60px); margin: -20px; position: relative;"
></div>

<script src="{{ asset('bundles/syliusworkflowplugin/workflow-editor.js') }}"></script>
{% endblock %}
