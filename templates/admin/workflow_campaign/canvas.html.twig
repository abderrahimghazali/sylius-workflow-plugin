{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ 'workflow.ui.edit_canvas'|trans }}: {{ campaign.name }} | {{ parent() }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        <div
            id="sylius-workflow-editor"
            data-workflow-id="{{ campaign.id }}"
            data-graph="{{ campaign.graph|json_encode|e('html_attr') }}"
            data-api-url="{{ path('sylius_workflow_api_save_graph', {id: campaign.id}) }}"
            data-workflow-name="{{ campaign.name|e('html_attr') }}"
            data-workflow-status="{{ campaign.status.value }}"
            data-runs-url="{{ path('workflow_admin_run_index', {id: campaign.id}) }}"
            data-back-url="{{ path('workflow_admin_campaign_edit', {id: campaign.id}) }}"
            style="height: calc(100vh - 60px); position: relative;"
        ></div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/syliusworkflowplugin/workflow-editor.js') }}"></script>
{% endblock %}
