{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ 'workflow.ui.run_log'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
    {% include '@SyliusAdmin/shared/crud/common/sidebar.html.twig' %}

    <div class="page-wrapper">
        {% include '@SyliusAdmin/shared/crud/common/navbar.html.twig' %}

        {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}

        {% from '@SyliusAdmin/shared/helper/breadcrumbs.html.twig' import breadcrumbs %}
        <div class="page-header" data-sticky-header>
            <div class="container-xl">
                {{ breadcrumbs([
                    { name: 'sylius.ui.dashboard', url: path('sylius_admin_dashboard'), active: false },
                    { name: 'workflow.ui.automation_workflows', url: path('workflow_admin_campaign_index'), active: false },
                    { name: campaign.name, url: path('workflow_admin_campaign_edit', {id: campaign.id}), active: false },
                    { name: 'workflow.ui.run_log', active: true },
                ]) }}
                <div class="row mt-3 row-gap-2">
                    <div class="col-12 col-md">
                        <h1 class="page-title">{{ 'workflow.ui.run_log'|trans }}</h1>
                    </div>
                    <div class="col-auto">
                        <a href="{{ path('workflow_admin_campaign_edit', {id: campaign.id}) }}" class="btn">
                            {{ 'sylius.ui.back'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                {% if runs|length > 0 %}
                    <div class="card">
                        <div class="table-responsive">
                            <table class="table card-table table-vcenter datatable">
                                <thead>
                                    <tr>
                                        <th>{{ 'workflow.ui.run_id'|trans }}</th>
                                        <th>{{ 'workflow.ui.subject'|trans }}</th>
                                        <th>{{ 'workflow.ui.status'|trans }}</th>
                                        <th>{{ 'workflow.ui.started_at'|trans }}</th>
                                        <th>{{ 'workflow.ui.duration'|trans }}</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for run in runs %}
                                        {% set status_colors = {
                                            'completed': 'success',
                                            'failed': 'danger',
                                            'skipped': 'warning',
                                            'running': 'info',
                                        } %}
                                        <tr>
                                            <td>#{{ run.id }}</td>
                                            <td>{{ run.subjectType|capitalize }} #{{ run.subjectId }}</td>
                                            <td>
                                                <span class="badge text-white bg-{{ status_colors[run.status.value] ?? 'secondary' }}">
                                                    {{ run.status.value }}
                                                </span>
                                            </td>
                                            <td>{{ run.startedAt|date('Y-m-d H:i:s') }}</td>
                                            <td>
                                                {% if run.completedAt %}
                                                    {{ run.completedAt.timestamp - run.startedAt.timestamp }}s
                                                {% else %}
                                                    —
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="{{ path('workflow_admin_run_show', {campaignId: campaign.id, runId: run.id}) }}"
                                                   class="btn btn-sm btn-outline-primary">
                                                    {{ 'workflow.ui.view_details'|trans }}
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% if totalPages > 1 %}
                            <div class="card-footer d-flex align-items-center gap-2 flex-wrap">
                                <div class="text-muted">
                                    {% set from = (page - 1) * 20 + 1 %}
                                    {% set to = page * 20 %}
                                    {% set to = to < total ? to : total %}
                                    {{ 'sylius.ui.pagination.number_of_results'|trans({'%from%': from, '%to%': to, '%total%': total}) }}
                                </div>
                                <div class="ms-auto">
                                    <ul class="pagination m-0">
                                        <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                                            <a class="page-link" href="{{ path('workflow_admin_run_index', {id: campaign.id, page: page - 1}) }}" rel="prev">
                                                &lsaquo;
                                            </a>
                                        </li>
                                        {% for p in range(1, totalPages) %}
                                            {% if p == page %}
                                                <li class="page-item active" aria-current="page">
                                                    <span class="page-link">{{ p }}</span>
                                                </li>
                                            {% else %}
                                                <li class="page-item">
                                                    <a class="page-link" href="{{ path('workflow_admin_run_index', {id: campaign.id, page: p}) }}">{{ p }}</a>
                                                </li>
                                            {% endif %}
                                        {% endfor %}
                                        <li class="page-item {{ page >= totalPages ? 'disabled' : '' }}">
                                            <a class="page-link" href="{{ path('workflow_admin_run_index', {id: campaign.id, page: page + 1}) }}" rel="next">
                                                &rsaquo;
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="card">
                        <div class="card-body text-center text-secondary py-5">
                            {{ 'workflow.ui.no_runs_yet'|trans }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {% include '@SyliusAdmin/shared/crud/common/content/footer.html.twig' %}
    </div>
{% endblock %}
