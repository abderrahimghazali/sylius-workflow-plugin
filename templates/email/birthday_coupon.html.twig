{% extends '@SyliusWorkflowPlugin/email/_base.html.twig' %}

{% block content %}
    <div class="header">
        <h1>Happy Birthday! 🎂</h1>
    </div>
    <div class="body">
        <p>Hi {{ customer.firstName|default('there') }},</p>
        <p>Wishing you a wonderful birthday! To celebrate, here's a special gift from us:</p>
        {% if coupon is defined and coupon.code is defined %}
            <div class="coupon-box">
                <div style="font-size: 12px; color: #666; margin-bottom: 4px;">Your birthday gift</div>
                <div class="coupon-code">{{ coupon.code }}</div>
            </div>
        {% endif %}
        <p style="text-align: center; margin: 24px 0;">
            <a href="#" class="btn">Treat Yourself</a>
        </p>
        <p>Have a great day!</p>
    </div>
{% endblock %}
