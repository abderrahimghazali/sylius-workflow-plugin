<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { margin: 0; padding: 0; background: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        .wrapper { max-width: 560px; margin: 0 auto; padding: 40px 20px; }
        .card { background: #ffffff; border-radius: 8px; padding: 32px; }
        .header { text-align: center; margin-bottom: 24px; }
        .header h1 { font-size: 22px; color: #1a1a1a; margin: 0; }
        .body { font-size: 15px; line-height: 1.6; color: #444; }
        .body p { margin: 0 0 16px; }
        .btn { display: inline-block; padding: 12px 28px; background: #378ADD; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; }
        .coupon-box { background: #f0f7ff; border: 2px dashed #378ADD; border-radius: 8px; padding: 16px; text-align: center; margin: 20px 0; }
        .coupon-code { font-size: 24px; font-weight: 700; color: #378ADD; letter-spacing: 2px; }
        .footer { text-align: center; margin-top: 24px; font-size: 12px; color: #999; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="card">
            {% block content %}{% endblock %}
        </div>
        <div class="footer">
            {% block footer %}
                Sent by {{ workflow.name|default('Automated Workflow') }}
            {% endblock %}
        </div>
    </div>
</body>
</html>
